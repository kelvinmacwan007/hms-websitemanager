PATEL_HMS_API_URL=https://dev-aiapi.patelhms.com
PATEL_HMS_API_KEY=
PATEL_HMS_API_SECRET=
# Server-only JSON map keyed by tenant ID. Keep credentials out of NEXT_PUBLIC_*.
# Example: {"hotel-a":{"userIdentity":"...","password":"...","customerCode":"...","propertyId":"...","currency":"USD","propertyPackageId":"...","checkInTime":"15:00","checkOutTime":"12:00"}}
PATEL_HMS_TENANTS_JSON=
# propertyPackageId selects the HMS rate package. Match currency to the property.
# Optional hotel snapshot; omit to use the API login property profile.
PATEL_HMS_PROPERTIES_FILE=
# Durable shared directory used to prevent duplicate reservation/payment attempts.
PATEL_HMS_BOOKING_STORE=.data/hms-bookings
# Optional tenant for localhost during live development (never enabled in production).
PATEL_HMS_LOCAL_TENANT_ID=
WEBSITE_ENV=mock
# Optional hotel for plain localhost in mock mode; hotel1.localhost and hotel2.localhost select their own demos.
DEMO_TENANT_ID=demo-hotel
PATEL_HMS_ROOT_DOMAIN=kelvinmacwan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared online Website Studio: authenticate using the existing HMS login API.
WEBSITE_MANAGER_AUTH=hms
# Optional standalone accounts are used only when auth is not hms.
WEBSITE_MANAGER_HOST=websites.kelvinmacwan.com
# Node script: node scripts/create-manager-user.mjs USERNAME TENANT_ID
# Example: [{"username":"admin","passwordHash":"scrypt:SALT:HASH","tenantId":"hotel-a"}]
WEBSITE_MANAGER_USERS_JSON=
WEBSITE_MANAGER_SESSION_SECRET=
# Durable directory shared by the manager and all public hotel domains.
# Configure on Hostinger for production; back it up before redeploying.
WEBSITE_DATA_DIR=

# Include required build tools on production hosting installs
NPM_CONFIG_INCLUDE=dev

# Optional explicit HMS website editors per tenant. An empty list denies everyone.
# Without an entry, only the configured tenant connection username can edit.
WEBSITE_MANAGER_EDITORS_JSON={}
